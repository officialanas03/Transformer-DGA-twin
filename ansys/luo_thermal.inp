! luo_thermal.inp  -- steady-state 2D axisymmetric winding thermal model (Mechanical APDL)
! UNTESTED: written without access to ANSYS. If a line errors, copy the error text to Claude.
! Units: SI (m, W, C). Axis of symmetry = Y axis. Everything below marked ASSUMED is a PLACEHOLDER,
! not from Luo et al. 2023 (the paper gives no geometry, losses or boundary data).

/CLEAR,NOSTART
/PREP7

! ---------- inputs you change ----------
LOAD  = 1.3        ! per-unit load (paper: 0.74 base case, 1.3 overload)
LTAG  = '1p30'      ! text tag for the output file name: '0p74' or '1p30'
Q0    = 1.0E5       ! ASSUMED heat generation at load 0.74 (W/m3). CALIBRATION KNOB
HF    = 72         ! ASSUMED film coefficient (W/m2K). CALIBRATION KNOB
TBOT  = 20          ! ASSUMED oil temperature at bottom (C)
TTOP  = 40          ! ASSUMED oil temperature at top (C). CALIBRATION KNOB
KCU   = 385         ! ASSUMED copper conductivity (W/mK); replace with your library value if you wish
HT    = 1.2         ! ASSUMED winding height (m)

QV = Q0*(LOAD/0.74)**2   ! ASSUMED: losses proportional to current squared

! ---------- model ----------
ET,1,PLANE55
KEYOPT,1,3,1              ! axisymmetric
MP,KXX,1,KCU

RECTNG,0.250,0.290,0,HT   ! area 1 = LV winding (ASSUMED dimensions)
RECTNG,0.340,0.400,0,HT   ! area 2 = HV winding (ASSUMED dimensions)

ESIZE,0.01
AMESH,ALL

! ---------- loads ----------
/SOLU
ANTYPE,STATIC
BFA,ALL,HGEN,QV           ! volumetric heat generation in both windings

*DIM,TBLB,TABLE,2,1,1,Y   ! oil temperature rising linearly with height
TBLB(1,0)=0
TBLB(2,0)=HT
TBLB(1,1)=TBOT
TBLB(2,1)=TTOP

ALLSEL
LSEL,ALL
NSLL,S,1
SF,ALL,CONV,HF,%TBLB%     ! convection on all outer edges
ALLSEL
SOLVE
FINISH

! ---------- results ----------
/POST1
SET,LAST

ASEL,S,AREA,,1
NSLA,S,1
NSORT,TEMP
*GET,TMAXLV,SORT,0,MAX
*GET,NMAX,SORT,0,IMAX
YMAX = NY(NMAX)
*MSG,INFO,LOAD,TMAXLV,YMAX
Load=%G pu:  LV maximum temperature = %G C at y = %G m

ALLSEL
*GET,NN,NODE,0,COUNT
*DIM,ID,ARRAY,NN
*DIM,XN,ARRAY,NN
*DIM,YN,ARRAY,NN
*DIM,TN,ARRAY,NN
*VGET,ID(1),NODE,,NLIST
*VGET,XN(1),NODE,ID(1),LOC,X
*VGET,YN(1),NODE,ID(1),LOC,Y
*VGET,TN(1),NODE,ID(1),TEMP

*CFOPEN,T_load%LTAG%,csv
*VWRITE
('node,x_m,y_m,T_C')
*VWRITE,ID(1),XN(1),YN(1),TN(1)
(F8.0,',',E14.6,',',E14.6,',',E14.6)
*CFCLOS
